        { "value": "center", "label": "Do środka" },
        { "value": "left", "label": "Do lewej" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Wygląd"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Tło sekcji",
      "default": "#F7F5F1"
