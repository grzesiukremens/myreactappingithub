{% comment %}
  Section contract.
  Vellano – nagłówek kolekcji (landing klubu, Wszystkie zawieszki, landingi prezentowe).
  Jeden szablon obsługuje wszystkie kolekcje, bo treść pochodzi z metapól bieżącej kolekcji:
  - collection.metafields.custom.hero_eyebrow (tekst jednowierszowy) → eyebrow,
  - collection.metafields.custom.hero_heading (tekst jednowierszowy) → nagłówek H1,
  - collection.metafields.custom.hero_body (tekst wielowierszowy) → akapit pod nagłówkiem,
  - collection.image → zdjęcie (albo zdjęcie z ustawień sekcji, albo zdjęcie pierwszego produktu).
  Puste metapole = wartość zastępcza z ustawień sekcji; pusty nagłówek = tytuł kolekcji.
  Poza szablonem kolekcji sekcja czyta kolekcję wybraną w ustawieniu „Kolekcja”.
  Mobile (do 749 px): treść na jasnym tle; zdjęcie jako miniatura nad tekstem, na pełną szerokość albo ukryte,
  żeby karta produktu pojawiła się szybko. Desktop (od 750 px): dwie kolumny, zdjęcie po prawej albo po lewej.
  Gdy sekcja jest pierwsza w szablonie, zdjęcie ładuje się od razu (fetchpriority high).
  Tryb „prezent” (metapole kolekcji custom.hero_animacja = true, np. Prezent dla kibica): zdjęcie z wyciętym tłem
  bez tła kafelka, wjeżdża od dołu, potem delikatnie unosi się nad własnym cieniem; co kilka sekund przechodzi po nim
  pas światła maskowany kształtem zdjęcia, a na łańcuszku i napisie zapalają się drobne błyski
  (tylko dla zdjęcia 1838 × 1504 px z wyciętym opakowaniem, vellano-opakowanie-prezent-wyciete.webp,
  bo położenie błysków pasuje do tego zdjęcia; Shopify zapisuje zdjęcie kolekcji pod starą nazwą pliku).
  Na telefonie zdjęcie jest wtedy średniej wielkości zamiast miniatury. Przy „ogranicz ruch” zdjęcie stoi.
  @example
  <!-- templates/collection.klub.json → "vellano_club_hero": { "type": "vellano-club-hero", "settings": { "mobile_media": "thumbnail", "badge_text": "Oficjalny produkt licencjonowany" } } -->
{% endcomment %}

{%- liquid
  assign resource = collection
  if resource == blank
    assign resource = section.settings.collection
  endif

  assign eyebrow = ''
  assign heading = ''
  assign subheading = ''
  assign body = ''
  assign image = section.settings.image

  if resource != blank
    assign mf_eyebrow = resource.metafields.custom.hero_eyebrow.value | strip
    assign mf_heading = resource.metafields.custom.hero_heading.value | strip
    assign mf_body = resource.metafields.custom.hero_body.value | strip

    assign eyebrow = mf_eyebrow | default: section.settings.eyebrow
    if section.settings.heading_source == 'title'
      assign heading = resource.title
      assign subheading = mf_heading
    else
      assign heading = mf_heading | default: section.settings.heading | default: resource.title
    endif
    assign body = mf_body | default: section.settings.text

    if image == blank
      if section.settings.image_source == 'product' and resource.products.first.featured_media != blank
        assign image = resource.products.first.featured_media.preview_image
      elsif resource.image != blank
        assign image = resource.image
      elsif resource.products.first.featured_media != blank
        assign image = resource.products.first.featured_media.preview_image
      endif
    endif
  else
    assign eyebrow = section.settings.eyebrow
    assign heading = section.settings.heading
    assign body = section.settings.text
  endif

  assign gift_mode = false
  if resource != blank and image != blank and resource.metafields.custom.hero_animacja.value == true
    assign gift_mode = true
  endif

  assign eyebrow = eyebrow | strip
  assign heading = heading | strip
  assign subheading = subheading | strip
  assign body = body | strip
  assign badge_text = section.settings.badge_text | strip

  if section.index == 1
    assign image_loading = 'eager'
    assign image_priority = 'high'
  else
    assign image_loading = 'lazy'
    assign image_priority = 'auto'
  endif

  assign image_alt = ''
  assign image_ratio = 0.8
  if image != blank
    assign image_alt = image.alt | default: heading | escape
    assign image_ratio = image.aspect_ratio | default: 0.8
  endif

  if gift_mode
    assign image_sizes = '(min-width: 1440px) 720px, (min-width: 750px) 50vw, 86vw'
  elsif section.settings.mobile_media == 'thumbnail'
    assign image_sizes = '(min-width: 1440px) 720px, (min-width: 750px) 50vw, 128px'
  else
    assign image_sizes = '(min-width: 1440px) 720px, (min-width: 750px) 50vw, 100vw'
  endif

  capture modifier_classes
    echo ' vellano-club-hero--media-' | append: section.settings.media_position
    echo ' vellano-club-hero--mobile-' | append: section.settings.mobile_media
    echo ' vellano-club-hero--align-' | append: section.settings.mobile_alignment
    if image == blank
      echo ' vellano-club-hero--no-media'
    endif
    if gift_mode
      echo ' vellano-club-hero--gift'
    endif
  endcapture
-%}

{% render 'vellano-ui-styles' %}

{%- if section.settings.background_color != blank -%}
  {% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}
{%- endif -%}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>
<div
  class="section section--page-width vellano-club-hero{{ modifier_classes }} spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --vellano-club-hero-ratio: {{ image_ratio }};
  "
>
  {%- if image != blank -%}
    <div class="vellano-club-hero__media">
      {%- if gift_mode -%}
        <div class="vellano-gift">
          <div class="vellano-gift__shadow" aria-hidden="true">
            {{
              image
              | image_url: width: 1600
              | image_tag:
                widths: '128, 256, 375, 550, 750, 1000, 1200, 1600',
                sizes: image_sizes,
                loading: image_loading,
                alt: '',
                class: 'vellano-gift__shadow-image'
            }}
          </div>
          <div class="vellano-gift__float">
            {{
              image
              | image_url: width: 1600
              | image_tag:
                widths: '128, 256, 375, 550, 750, 1000, 1200, 1600',
                sizes: image_sizes,
                loading: image_loading,
                fetchpriority: image_priority,
                alt: image_alt,
                class: 'vellano-club-hero__image vellano-gift__image'
            }}
            <span
              class="vellano-gift__shine"
              style="--gift-mask: url('{{ image | image_url: width: 900 }}');"
              aria-hidden="true"
            ></span>
            {%- if image.width == 1838 and image.height == 1504 -%}
              <i class="vellano-gift__spark" style="left: 52.29%; top: 46.68%; animation-delay: 0.6s;"></i>
              <i class="vellano-gift__spark" style="left: 47.88%; top: 52.73%; animation-delay: 2s;"></i>
              <i class="vellano-gift__spark" style="left: 48.1%; top: 57.65%; animation-delay: 3.4s;"></i>
              <i class="vellano-gift__spark vellano-gift__spark--small" style="left: 26.55%; top: 26.99%; animation-delay: 4.6s;"></i>
            {%- endif -%}
          </div>
        </div>
      {%- else -%}
        {{
          image
          | image_url: width: 1600
          | image_tag:
            widths: '128, 256, 375, 550, 750, 1000, 1200, 1600',
            sizes: image_sizes,
            loading: image_loading,
            fetchpriority: image_priority,
            alt: image_alt,
            class: 'vellano-club-hero__image'
        }}
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="vellano-club-hero__content vellano-ui">
    {%- if eyebrow != blank -%}
      <p class="vellano-eyebrow vellano-club-hero__eyebrow">{{ eyebrow | escape }}</p>
    {%- endif -%}

    {%- if heading != blank -%}
      <h1 class="vellano-club-hero__heading {{ section.settings.heading_preset }}">{{ heading | escape }}</h1>
    {%- endif -%}

    {%- if subheading != blank -%}
      <p class="vellano-club-hero__subheading h4">{{ subheading | escape }}</p>
    {%- endif -%}

    {%- if body != blank -%}
      <div class="vellano-club-hero__text">
        <p>{{ body | escape | newline_to_br }}</p>
      </div>
    {%- endif -%}

    {%- if badge_text != blank -%}
      {%- if section.settings.badge_link != blank -%}
        <a class="vellano-club-hero__badge vellano-club-hero__badge--link" href="{{ section.settings.badge_link }}">
          {%- render 'vellano-icon', icon: 'shield', class: 'vellano-club-hero__badge-icon', size: 16 -%}
          <span>{{ badge_text | escape }}</span>
        </a>
      {%- else -%}
        <p class="vellano-club-hero__badge">
          {%- render 'vellano-icon', icon: 'shield', class: 'vellano-club-hero__badge-icon', size: 16 -%}
          <span>{{ badge_text | escape }}</span>
        </p>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  /* Mobile first. */
  .vellano-club-hero {
    align-items: start;
  }

  .vellano-club-hero > .vellano-club-hero__media {
    overflow: hidden;
    aspect-ratio: var(--vellano-club-hero-ratio, 0.8);
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
  }

  .vellano-club-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vellano-club-hero--mobile-thumbnail > .vellano-club-hero__media {
    justify-self: center;
    width: 128px;
    margin-block-end: 20px;
  }

  .vellano-club-hero--mobile-full > .vellano-club-hero__media {
    grid-column: 1 / -1;
    margin-block-end: 28px;
  }

  .vellano-club-hero--mobile-hidden > .vellano-club-hero__media {
    display: none;
  }

  .vellano-club-hero > .vellano-club-hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    min-width: 0;
    text-align: center;
  }

  .vellano-club-hero--align-left > .vellano-club-hero__content {
    align-items: flex-start;
    text-align: start;
  }

  .vellano-club-hero--mobile-thumbnail.vellano-club-hero--align-left > .vellano-club-hero__media {
    justify-self: start;
  }

  .vellano-club-hero__heading {
    margin: 0;
    max-width: 18em;
    text-wrap: balance;
  }

  .vellano-club-hero__subheading {
    margin: 0;
    text-wrap: balance;
  }

  .vellano-club-hero__text {
    max-width: 34em;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    font-size: 1rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .vellano-club-hero__text p {
    margin: 0;
  }

  .vellano-club-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: var(--minimum-touch-target, 44px);
    margin: 4px 0 0;
    padding-inline: 14px;
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-40));
    border-radius: 2px;
    color: var(--color-foreground);
    /* Ten sam styl co odznaka licencji na karcie produktu (blocks/vellano-badge): krój akcentowy, wersaliki. */
    font-family: var(--font-accent--family);
    font-style: var(--font-accent--style);
    font-weight: var(--font-accent--weight);
    font-size: 0.75rem;
    line-height: 1.3;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .vellano-club-hero__badge-icon {
    flex: 0 0 auto;
  }

  .vellano-club-hero__badge--link:hover {
    border-color: var(--color-foreground);
  }

  .vellano-club-hero__badge--link:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .vellano-club-hero__badge--link {
      transition: border-color var(--animation-speed) var(--animation-easing);
    }
  }

  /* Tryb „prezent”: zdjęcie z wyciętym tłem unosi się nad własnym, rozmytym cieniem. */
  .vellano-club-hero--gift > .vellano-club-hero__media {
    overflow: visible;
    background-color: transparent;
  }

  @media screen and (max-width: 749px) {
    .vellano-club-hero--gift.vellano-club-hero--mobile-thumbnail > .vellano-club-hero__media {
      width: min(84%, 360px);
      margin-block-end: 16px;
    }
  }

  .vellano-gift,
  .vellano-gift__float {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .vellano-club-hero .vellano-gift__image {
    object-fit: contain;
    filter: drop-shadow(0 10px 14px rgb(20 20 20 / 0.1));
  }

  /* Cień na „podłodze”: ta sama sylwetka, przyciemniona i rozmyta, lekko pod zdjęciem. Zostaje w miejscu. */
  .vellano-gift__shadow {
    position: absolute;
    inset: 0;
    translate: 0 3.5%;
    opacity: 0.2;
    filter: brightness(0) blur(14px);
    pointer-events: none;
  }

  .vellano-gift__shadow-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .vellano-gift__shine,
  .vellano-gift__spark {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .vellano-gift {
      animation: vellano-gift-in 1.2s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    .vellano-gift__float {
      animation: vellano-gift-float 7s ease-in-out 1.2s infinite;
      will-change: translate, rotate;
    }

    .vellano-gift__shadow {
      animation: vellano-gift-shadow 7s ease-in-out 1.2s infinite;
    }

    /* Pas światła maskowany kształtem zdjęcia, jak w hero strony głównej. */
    .vellano-gift__shine {
      display: block;
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
      mix-blend-mode: screen;
      -webkit-mask-image: var(--gift-mask);
      mask-image: var(--gift-mask);
      -webkit-mask-size: contain;
      mask-size: contain;
      -webkit-mask-position: center;
      mask-position: center;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
    }

    .vellano-gift__shine::before {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      width: 300%;
      background: linear-gradient(
        105deg,
        rgb(255 255 255 / 0) 0%,
        rgb(255 255 255 / 0) 46%,
        rgb(255 255 255 / 0.14) 48.4%,
        rgb(255 255 255 / 0.5) 50%,
        rgb(255 255 255 / 0.14) 51.6%,
        rgb(255 255 255 / 0) 54%,
        rgb(255 255 255 / 0) 100%
      );
      translate: -60% 0;
      animation: vellano-gift-shine 7s ease-in-out 1.8s infinite;
    }

    .vellano-gift__spark {
      display: block;
      position: absolute;
      width: 3%;
      aspect-ratio: 1;
      translate: -50% -50%;
      opacity: 0;
      background: radial-gradient(circle, rgb(255 255 255 / 0.95) 0 9%, rgb(255 255 255 / 0) 32%);
      mix-blend-mode: screen;
      pointer-events: none;
      animation: vellano-gift-twinkle 5.6s ease-in-out infinite;
    }

    .vellano-gift__spark--small {
      width: 2.2%;
    }

    .vellano-gift__spark::before,
    .vellano-gift__spark::after {
      content: '';
      position: absolute;
      border-radius: 50%;
    }

    .vellano-gift__spark::before {
      inset: 46% 0;
      background: linear-gradient(90deg, rgb(255 255 255 / 0), rgb(255 255 255 / 0.95) 50%, rgb(255 255 255 / 0));
    }

    .vellano-gift__spark::after {
      inset: 0 46%;
      background: linear-gradient(180deg, rgb(255 255 255 / 0), rgb(255 255 255 / 0.95) 50%, rgb(255 255 255 / 0));
    }
  }

  @keyframes vellano-gift-in {
    from {
      opacity: 0;
      translate: 0 18px;
      scale: 0.985;
    }

    to {
      opacity: 1;
      translate: 0 0;
      scale: 1;
    }
  }

  @keyframes vellano-gift-float {
    0%,
    100% {
      translate: 0 0;
      rotate: -0.25deg;
    }

    50% {
      translate: 0 -1.6%;
      rotate: 0.3deg;
    }
  }

  @keyframes vellano-gift-shadow {
    0%,
    100% {
      opacity: 0.2;
      scale: 1;
    }

    50% {
      opacity: 0.13;
      scale: 0.965;
    }
  }

  @keyframes vellano-gift-shine {
    0% {
      translate: -60% 0;
    }

    26%,
    100% {
      translate: -6.667% 0;
    }
  }

  @keyframes vellano-gift-twinkle {
    0%,
    62%,
    100% {
      opacity: 0;
      scale: 0.3;
      rotate: 0deg;
    }

    72% {
      opacity: 1;
      scale: 1;
      rotate: 45deg;
    }

    84% {
      opacity: 0;
      scale: 0.4;
      rotate: 90deg;
    }
  }

  @media screen and (min-width: 750px) {
    .vellano-club-hero:not(.vellano-club-hero--no-media) {
      grid-template-columns:
        var(--full-page-grid-margin)
        repeat(2, calc(var(--full-page-grid-central-column-width) / 2))
        var(--full-page-grid-margin);
      grid-template-areas: 'margin-start content media margin-end';
      align-items: center;
    }

    .vellano-club-hero--media-left:not(.vellano-club-hero--no-media) {
      grid-template-areas: 'margin-start media content margin-end';
    }

    .vellano-club-hero > .vellano-club-hero__media,
    .vellano-club-hero--mobile-thumbnail > .vellano-club-hero__media,
    .vellano-club-hero--mobile-full > .vellano-club-hero__media,
    .vellano-club-hero--mobile-hidden > .vellano-club-hero__media {
      display: block;
      grid-area: media;
      justify-self: stretch;
      width: auto;
      max-height: 70svh;
      margin: 0;
    }

    /* Zdjęcie prezentu zachowuje swoje proporcje (bez obcinania wysokości), żeby błyski i maska pasowały do zdjęcia. */
    .vellano-club-hero--gift > .vellano-club-hero__media {
      max-height: none;
      align-self: center;
    }

    .vellano-club-hero:not(.vellano-club-hero--no-media) > .vellano-club-hero__content {
      grid-area: content;
      align-items: flex-start;
      gap: 16px;
      padding-block: 32px;
      padding-inline-end: clamp(24px, 5vw, 80px);
      text-align: start;
    }

    .vellano-club-hero--media-left:not(.vellano-club-hero--no-media) > .vellano-club-hero__content {
      padding-inline: clamp(24px, 5vw, 80px) 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vellano – hero kolekcji",
  "tag": "section",
  "class": "section-wrapper vellano-club-hero-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Eyebrow, nagłówek i tekst pochodzą z metapól kolekcji: custom.hero_eyebrow, custom.hero_heading i custom.hero_body. Pola poniżej to wartości zastępcze, gdy metapole jest puste."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Kolekcja (poza szablonem kolekcji)",
      "info": "Na stronie kolekcji sekcja zawsze czyta bieżącą kolekcję."
    },
    {
      "type": "header",
      "content": "Treść zastępcza"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Kolekcja"
    },
    {
      "type": "select",
      "id": "heading_source",
      "label": "Nagłówek H1",
      "options": [
        { "value": "metafield", "label": "Z metapola custom.hero_heading" },
        { "value": "title", "label": "Tytuł kolekcji (metapole jako podtytuł)" }
      ],
      "default": "metafield"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Nagłówek",
      "info": "Puste pole = tytuł kolekcji."
    },
    {
      "type": "select",
      "id": "heading_preset",
      "label": "Wielkość nagłówka",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ],
      "default": "h1"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Tekst"
    },
    {
      "type": "header",
      "content": "Oznaczenie licencji"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Tekst oznaczenia",
      "info": "Puste pole = bez oznaczenia.",
      "default": "Oficjalny produkt licencjonowany"
    },
    {
      "type": "url",
      "id": "badge_link",
      "label": "Link oznaczenia"
    },
    {
      "type": "header",
      "content": "Zdjęcie"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Zdjęcie (opcjonalnie)",
      "info": "Puste pole = zdjęcie kolekcji."
    },
    {
      "type": "select",
      "id": "image_source",
      "label": "Gdy brak zdjęcia w ustawieniach",
      "options": [
        { "value": "collection", "label": "Zdjęcie kolekcji" },
        { "value": "product", "label": "Pierwsze zdjęcie pierwszego produktu" }
      ],
      "default": "collection"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Zdjęcie na komputerze",
      "options": [
        { "value": "right", "label": "Po prawej" },
        { "value": "left", "label": "Po lewej" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "mobile_media",
      "label": "Zdjęcie na telefonie",
      "options": [
        { "value": "thumbnail", "label": "Miniatura nad tekstem" },
        { "value": "full", "label": "Na pełną szerokość" },
        { "value": "hidden", "label": "Ukryte" }
      ],
      "default": "thumbnail"
    },
    {
      "type": "select",
      "id": "mobile_alignment",
