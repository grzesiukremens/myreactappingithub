{% comment %}
  Section contract.
  Vellano – „Zanim zapytasz” w wersji ogólnej (strona główna, kolekcje): lejek pytań przed zakupem,
  w którym każda odpowiedź stoi obok zdjęcia z bliska.
  Treść z bloków „Pytanie” (pytanie, odpowiedź jako rich text – może zawierać linki, zdjęcie, opcjonalny alt).
  Wersję produktową z metapola custom.zanim_zapytasz renderuje osobna sekcja vellano-zanim-zapytasz.
  Akordeon na natywnych <details>/<summary> (bez JS); atrybut name sprawia, że w nowych przeglądarkach
  otwarta jest jedna odpowiedź naraz. Pierwsza odpowiedź może być otwarta domyślnie.
  Mobile (do 749 px): nagłówek, pod nim lista; w otwartej odpowiedzi zdjęcie 1:1 nad tekstem.
  Od 750 px: zdjęcie obok tekstu. Od 990 px: nagłówek w lewej kolumnie (przyklejony), lista w prawej.
  Zdjęcia ładują się leniwie (loading lazy), więc zamknięte odpowiedzi nie obciążają strony.
  @example
  <!-- "vellano_faq_visual": { "type": "vellano-faq-visual", "blocks": { "q1": { "type": "question", "settings": { "question": "Czy łańcuszek jest w zestawie?", "answer": "<p>Tak…</p>", "image": "shopify://shop_images/zawieszka-real-madryt-na-lancuszku.webp" } } }, "block_order": ["q1"] } -->
{% endcomment %}

{%- liquid
  assign eyebrow = section.settings.eyebrow | strip
  assign heading = section.settings.heading | strip
  assign link_label = section.settings.link_label | strip
  assign group_name = 'vellano-faq-visual-' | append: section.id

  assign has_items = false
  for block in section.blocks
    if block.settings.question != blank
      assign has_items = true
      break
    endif
  endfor
-%}

{%- if has_items or request.design_mode -%}
  {% render 'vellano-ui-styles' %}

  {%- if section.settings.background_color != blank -%}
    {% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}
  {%- endif -%}

  <div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>
  <div
    class="section section--page-width spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
    style="
      {% render 'spacing-style', settings: section.settings %}
      {% if section.settings.line_color != blank %}--vellano-faq-visual-line: {{ section.settings.line_color }};{% endif %}
    "
  >
    <div class="vellano-faq-visual vellano-ui">
      {%- if eyebrow != blank or heading != blank or section.settings.intro != blank -%}
        <header class="vellano-faq-visual__header">
          {%- if eyebrow != blank -%}
            <p class="vellano-eyebrow">{{ eyebrow | escape }}</p>
          {%- endif -%}
          {%- if heading != blank -%}
            <h2 class="vellano-faq-visual__heading h2">{{ heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.intro != blank -%}
            <div class="vellano-faq-visual__intro rte">{{ section.settings.intro }}</div>
          {%- endif -%}
          {%- if link_label != blank and section.settings.link_url != blank -%}
            <a class="vellano-text-link vellano-faq-visual__link vellano-faq-visual__link--desktop" href="{{ section.settings.link_url }}">
              {{- link_label | escape -}}
            </a>
          {%- endif -%}
        </header>
      {%- endif -%}

      <div class="vellano-faq-visual__list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign question = block.settings.question | strip
            assign photo = block.settings.image
            assign photo_alt = block.settings.image_alt | strip
            if photo_alt == blank and photo != blank
              assign photo_alt = photo.alt
            endif
            assign is_open = false
            if forloop.first and section.settings.open_first
              assign is_open = true
            endif
          -%}
          {%- if question != blank -%}
            <details
              class="vellano-faq-visual__item"
              name="{{ group_name }}"
              {% if is_open %}
                open
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <summary class="vellano-faq-visual__question">
                <span class="vellano-faq-visual__question-text">{{ question | escape }}</span>
                <span class="vellano-faq-visual__toggle" aria-hidden="true"></span>
              </summary>
              <div class="vellano-faq-visual__panel{% if photo == blank %} vellano-faq-visual__panel--no-media{% endif %}">
                {%- if photo != blank -%}
                  <div class="vellano-faq-visual__media">
                    {{
                      photo
                      | image_url: width: 720
                      | image_tag:
                        widths: '240, 360, 480, 720',
                        sizes: '(min-width: 750px) 220px, calc(100vw - 32px)',
                        loading: 'lazy',
                        alt: photo_alt,
                        class: 'vellano-faq-visual__image'
                    }}
                  </div>
                {%- endif -%}
                <div class="vellano-faq-visual__answer rte">{{ block.settings.answer }}</div>
              </div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if link_label != blank and section.settings.link_url != blank -%}
        <a class="vellano-text-link vellano-faq-visual__link vellano-faq-visual__link--mobile" href="{{ section.settings.link_url }}">
          {{- link_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .vellano-faq-visual {
    --vellano-faq-visual-line: rgb(var(--color-foreground-rgb) / var(--opacity-10));

    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    min-width: 0;
  }

  .vellano-faq-visual__header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    min-width: 0;
  }

  .vellano-faq-visual__heading {
    margin: 0;
    text-wrap: balance;
  }

  .vellano-faq-visual__intro {
    max-width: 34em;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .vellano-faq-visual__intro p {
    margin: 0;
  }

  .vellano-faq-visual__list {
    min-width: 0;
    border-block-start: 1px solid var(--vellano-faq-visual-line);
  }

  .vellano-faq-visual__item {
    border-block-end: 1px solid var(--vellano-faq-visual-line);
  }

  .vellano-faq-visual__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 56px;
    padding-block: 14px;
    cursor: pointer;
    list-style: none;
    color: var(--color-foreground);
  }

  .vellano-faq-visual__question::-webkit-details-marker {
    display: none;
  }

  .vellano-faq-visual__question:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .vellano-faq-visual__question-text {
    min-width: 0;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: 1.1875rem;
    line-height: 1.3;
    text-wrap: pretty;
  }

  /* Plus, który po otwarciu zamienia się w minus (obrót pionowej kreski). */
  .vellano-faq-visual__toggle {
    position: relative;
    flex: 0 0 auto;
    width: 14px;
    height: 14px;
  }

  .vellano-faq-visual__toggle::before,
  .vellano-faq-visual__toggle::after {
    content: '';
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0;
    width: 14px;
    height: 1.25px;
    background-color: currentcolor;
  }

  .vellano-faq-visual__toggle::after {
    transform: rotate(90deg);
  }

  .vellano-faq-visual__item[open] .vellano-faq-visual__toggle::after {
    transform: rotate(0deg);
  }

  .vellano-faq-visual__panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    padding-block: 0 24px;
  }

  .vellano-faq-visual__media {
    width: 100%;
    max-width: 360px;
    aspect-ratio: 1;
    overflow: hidden;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
  }

  .vellano-faq-visual__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vellano-faq-visual__answer {
    max-width: 34em;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .vellano-faq-visual__answer p {
    margin: 0;
  }

  .vellano-faq-visual__answer p + p {
    margin-block-start: 0.6em;
  }

  .vellano-faq-visual__answer a {
    color: var(--color-foreground);
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .vellano-faq-visual__link--desktop {
    display: none;
  }

  .vellano-faq-visual__link--mobile {
    justify-self: start;
  }

  @media (prefers-reduced-motion: no-preference) {
    .vellano-faq-visual__toggle::after {
      transition: transform var(--animation-speed) var(--animation-easing);
    }
  }

  @media screen and (min-width: 750px) {
    .vellano-faq-visual__panel {
      grid-template-columns: 220px minmax(0, 1fr);
      align-items: start;
      gap: 24px;
    }

    .vellano-faq-visual__panel--no-media {
      grid-template-columns: minmax(0, 1fr);
    }

    .vellano-faq-visual__question-text {
      font-size: 1.3125rem;
    }
  }

  @media screen and (min-width: 990px) {
    .vellano-faq-visual {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      column-gap: 64px;
      align-items: start;
    }

    .vellano-faq-visual__header {
      position: sticky;
      inset-block-start: calc(var(--sticky-header-offset, 0px) + 32px);
    }

    .vellano-faq-visual__link--desktop {
      display: inline-flex;
    }

    .vellano-faq-visual__link--mobile {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vellano – Zanim zapytasz (ogólne)",
  "tag": "section",
  "class": "section-wrapper vellano-faq-visual-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 12,
  "blocks": [
    {
      "type": "question",
      "name": "Pytanie",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Pytanie",
          "default": "Czy łańcuszek jest w zestawie?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Odpowiedź",
          "info": "Linki zapisuj jako link w edytorze, np. do /pages/zwroty. Bez liczby dni na zwrot.",
          "default": "<p>Tak. W zestawie jest skręcony łańcuszek o splocie linkowym, 51 cm.</p>"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Zdjęcie z bliska",
          "info": "Zdjęcie, które pokazuje dokładnie to, o co pyta klient. Kadr kwadratowy."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Tekst alternatywny zdjęcia (opcjonalnie)",
          "info": "Puste pole = tekst alternatywny zapisany przy pliku."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Nagłówek"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Z bliska"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Nagłówek",
      "default": "Zanim zapytasz."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Wstęp",
      "default": "<p>Pytania, które warto zadać przed zakupem. Przy każdej odpowiedzi stoi zdjęcie z bliska, które pokazuje dokładnie to, o co pytasz.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link – tekst",
      "default": "Wszystkie pytania"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link – adres"
    },
    {
      "type": "header",
      "content": "Akordeon"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Pierwsza odpowiedź otwarta",
      "default": true
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Kolor linii",
      "default": "#E6E2DA"
    },
    {
      "type": "header",
      "content": "Wygląd"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Tło sekcji",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Odstęp u góry",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Odstęp u dołu",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Vellano – Zanim zapytasz (ogólne)",
      "category": "Vellano",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "Czy łańcuszek jest w zestawie?",
            "answer": "<p>Tak. W zestawie jest skręcony, mocno połyskujący łańcuszek o splocie linkowym (rope), 51 cm (20 cali). Jeden rozmiar – nie musisz niczego dokupować.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Czy to oficjalny produkt?",
            "answer": "<p>Tak. To oficjalny produkt licencjonowany – herb, nazwa i barwy klubu są użyte za jego zgodą. Więcej na stronie <a href=\"/pages/oficjalna-licencja\">Oficjalna licencja</a>.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "A jeśli nie przypadnie do gustu?",
            "answer": "<p>Zasady zwrotów opisaliśmy na stronie <a href=\"/pages/zwroty\">Zwroty</a>. Jeśli coś będzie niejasne, <a href=\"/pages/contact\">napisz do nas</a> – pomożemy.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
