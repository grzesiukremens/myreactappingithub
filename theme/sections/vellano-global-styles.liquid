{% comment %}
  Section contract.
  Vellano – style globalne. Sekcja nie wyświetla treści. Leży w grupie nagłówka, więc ładuje się na każdej stronie
  i uzupełnia to, czego Horizon nie ma w ustawieniach motywu:
  - rozstrzelenie liter, grubość i rozmiar tekstu w przyciskach (.button, .button-secondary, .button-custom,
    przycisk „Kup teraz”); wersaliki i zaokrąglenie 2 px ustawia się w Ustawieniach motywu → Przyciski,
  - mniejsze rozmiary nagłówków H1–H3 poniżej 750 px (Horizon skaluje płynnie tylko rozmiary od 48 px),
  - spokojniejszy pasek ogłoszeń: interlinia przy zawijaniu tekstu i brak przenikania przy prefers-reduced-motion,
  - stopka na grafitowym tle: subtelne linie akordeonu, cele dotyku linków min. 44 px (także w dolnym pasku),
    widoczny focus pola e-mail,
  - wspólna karta produktu (przydomek, cena, „Kup teraz” na dole karty),
  - przycisk „Kup teraz” bez ikony i bez przycisków szybkiej płatności,
  - strzałki przesuwania zdjęć w stylu Vellano, widoczne także na telefonie; skrypt dokłada strzałki
    do galerii karty produktu na telefonie (Horizon w układzie siatki ich nie renderuje).
  Kolory pochodzą z tokenów motywu (--color-foreground, --color-input-text). Sekcji nie dodaje się do szablonów.

  @example
  <!-- sections/header-group.json -->
  "vellano_global_styles": { "type": "vellano-global-styles", "settings": { "button_letter_spacing": 8 } }
{% endcomment %}

{%- liquid
  assign button_letter_spacing = section.settings.button_letter_spacing | divided_by: 100.0
-%}

{% style %}
  body {
    --vellano-button-letter-spacing: {{ button_letter_spacing }}em;
    {%- if section.settings.button_font_size != blank %}
      --vellano-button-font-size: {{ section.settings.button_font_size }};
    {%- endif %}
  }

  {%- if section.settings.mobile_heading_sizes %}
    @media screen and (max-width: 749px) {
      body {
        --font-h1--size: {{ section.settings.mobile_h1_size | divided_by: 16.0 }}rem;
        --font-h2--size: {{ section.settings.mobile_h2_size | divided_by: 16.0 }}rem;
        --font-h3--size: {{ section.settings.mobile_h3_size | divided_by: 16.0 }}rem;
      }
    }
  {%- endif %}
{% endstyle %}

{% stylesheet %}
  /* Przyciski: wersaliki z rozstrzeleniem jak w salonie jubilerskim. */
  body :is(.button:not(.button-unstyled), .button-secondary, .button-custom),
  body button.shopify-payment-button__button--unbranded {
    font-size: var(--vellano-button-font-size, var(--font-paragraph--size));
    font-weight: 500;
    letter-spacing: var(--vellano-button-letter-spacing, 0.08em);
  }

  /* Pasek ogłoszeń: dłuższy komunikat może zawinąć się na telefonie, więc dajemy mu oddech. */
  .announcement-bar .announcement-bar__text {
    line-height: 1.4;
    text-wrap: balance;
  }

  /* Stopka: linie akordeonu tonowane względem tekstu zamiast pełnej bieli. */
  .footer-content .menu--dividers .menu__details {
    border-color: rgb(var(--color-foreground-rgb) / var(--opacity-20));
  }

  .footer-content .menu__item a {
    display: inline-flex;
    align-items: center;
    min-height: var(--minimum-touch-target, 44px);
    text-decoration: none;
  }

  .footer-content .menu__item a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  /* Wąska kolumna stopki (np. 990–1200 px): przycisk zapisu przechodzi pod pole zamiast je ściskać.
     Na telefonie Horizon i tak układa pole i przycisk jedno pod drugim. */
  @media screen and (min-width: 750px) {
    .footer-content .email-signup__input-group:not(.email-signup__input-group--integrated) {
      flex-wrap: wrap;
    }

    .footer-content .email-signup__input-group:not(.email-signup__input-group--integrated) .email-signup__input {
      flex: 1 1 12rem;
    }

    .footer-content .email-signup__input-group:not(.email-signup__input-group--integrated) .email-signup__button {
      flex: 1 0 auto;
    }
  }

  /* Dolny pasek stopki: przycisk z regulaminami i link nazwy sklepu jako pełne cele dotyku (min. 44 px). */
  .utilities .policy-list-trigger,
  .utilities .footer-utilities__text a {
    display: inline-flex;
    align-items: center;
    min-height: var(--minimum-touch-target, 44px);
  }

  .email-signup-block .email-signup__input:focus-visible {
    outline: 2px solid var(--color-input-text);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-bar .announcement-bar__slide {
      transition: none;
    }
  }

  /* ---------------------------------------------------------------------------
     Karta produktu Vellano (strona główna, kolekcje, „Kibicujesz komuś innemu?”,
     koszyk, 404). Ramkę, tło i odstępy ustawia blok karty w szablonie; tu są
     przydomek, cena, przycisk na dole karty i spokojny hover.
     --------------------------------------------------------------------------- */
  /* Zdjęcie kafelka: kwadrat na białym tle, zdjęcia z wyciętym tłem z metapól
     custom.zdjecie_karty (główne) i custom.zdjecie_karty_hover (po najechaniu). */
  .vellano-card-media {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: #ffffff;
  }

  .vellano-card-media__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity 0.35s ease, transform 0.6s ease;
  }

  .vellano-card-media__img--hover {
    opacity: 0;
  }

  @media (hover: hover) {
    product-card:hover .vellano-card-media--hover .vellano-card-media__img:not(.vellano-card-media__img--hover) {
      opacity: 0;
    }

    product-card:hover .vellano-card-media__img--hover {
      opacity: 1;
    }

    product-card:hover .vellano-card-media__img {
      transform: scale(1.03);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vellano-card-media__img {
      transition: none;
    }

    product-card:hover .vellano-card-media__img {
      transform: none;
    }
  }

  /* Płynne przewijanie do kotwic (np. „Wybierz swój klub” w hero → sekcja z klubami). */
  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }

  /* Małe kafelki Horizonu (menu „Wybierz swój klub” na komputerze i telefonie, podpowiedzi
     wyszukiwarki): te same zdjęcia z wyciętym tłem co na stronie głównej.
     snippets/resource-card.liquid dodaje klasę resource-card__image--vellano i format 1:1. */
  .resource-card__media:has(.resource-card__image--vellano) {
    position: relative;
    overflow: hidden;
    background-color: #ffffff;
    border: 1px solid #e6e2da;
    border-radius: var(--resource-card-corner-radius, 0);
  }

  .resource-card__image.resource-card__image--vellano {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    border-radius: 0;
    transition: opacity 0.35s ease;
  }

  .resource-card__image--secondary.resource-card__image--vellano {
    inset: 0 auto auto 0;
  }

  /* Miniatura w koszyku (szuflada i strona koszyka): to samo zdjęcie z wyciętym tłem. */
  .cart-items__media-image.cart-items__media-image--vellano {
    object-fit: contain;
    background-color: #ffffff;
    outline: 1px solid #e6e2da;
    outline-offset: -1px;
  }

  @media (prefers-reduced-motion: reduce) {
    .resource-card__image.resource-card__image--vellano {
      transition: none;
    }
  }

  .vellano-card-title {
    margin: 0;
    padding: 2px 12px 0;
    text-align: center;
    font-family: var(--font-body--family);
    font-weight: 500;
    font-size: 0.9375rem;
    line-height: 1.35;
    letter-spacing: normal;
    text-transform: none;
    color: var(--color-foreground);
    text-wrap: balance;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  .vellano-card-nickname {
    margin: 0;
    padding: 12px 12px 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-align: center;
    font-family: var(--font-accent--family);
    font-style: var(--font-accent--style);
    font-weight: var(--font-accent--weight);
    font-size: 0.75rem;
    line-height: 1.4;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .product-grid__card :is(product-price, .price) {
    font-weight: 500;
  }

  /* Przycisk zawsze na dole karty, także gdy nazwy mają różną długość. */
  .product-grid__card > .buy-buttons-block {
    margin-block-start: auto;
    width: 100%;
  }

  .product-grid__card .product-form-buttons {
    width: 100%;
  }

  @media (hover: hover) {
    .product-grid__card {
      transition: border-color var(--animation-speed, 0.2s) ease;
    }

    product-card:hover .product-grid__card {
      border-color: rgb(20 20 20 / 0.35);
    }
  }

  /* ---------------------------------------------------------------------------
     Przycisk „Kup teraz”: pełna szerokość, wersaliki, bez ikony koszyka.
     Przyciski szybkiej płatności (Shop Pay itp.) są wyłączone w szablonie;
     reguła poniżej to zabezpieczenie, gdyby blok został włączony w edytorze.
     --------------------------------------------------------------------------- */
  .add-to-cart-button {
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .product-form-buttons .add-to-cart-button {
    width: 100%;
    min-height: 52px;
  }

  .product-grid__card .product-form-buttons .add-to-cart-button {
    min-height: 44px;
    font-size: 0.8125rem;
  }

  .add-to-cart-button .add-to-cart-icon {
    display: none;
  }

  .accelerated-checkout-block {
    display: none !important;
  }

  /* ---------------------------------------------------------------------------
     Strzałki przesuwania zdjęć: biały krąg z cienką linią, ciemna strzałka.
     Na telefonie (brak hovera) strzałki są zawsze widoczne.
     --------------------------------------------------------------------------- */
  :is(.card-gallery, .resource-list__carousel, media-gallery) slideshow-arrows {
    mix-blend-mode: normal;
  }

  :is(.card-gallery, .resource-list__carousel, media-gallery) slideshow-arrows .slideshow-control,
  :is(.card-gallery, .resource-list__carousel, media-gallery) slideshow-arrows .slideshow-control.slideshow-control--shape-circle,
  .vellano-gallery-nav__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--minimum-touch-target, 44px);
    min-height: var(--minimum-touch-target, 44px);
    aspect-ratio: auto;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: #141414;
    cursor: pointer;
  }

  :is(.card-gallery, .resource-list__carousel, media-gallery) slideshow-arrows .slideshow-control .svg-wrapper,
  .vellano-gallery-nav__btn > span {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background-color: rgb(255 255 255 / 0.94);
    border: 1px solid #e6e2da;
    box-shadow: 0 1px 3px rgb(20 20 20 / 0.08);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  :is(.card-gallery, .resource-list__carousel, media-gallery) slideshow-arrows .slideshow-control svg,
  .vellano-gallery-nav__btn svg {
    width: 14px;
    height: 14px;
  }

  @media (hover: hover) {
    :is(.card-gallery, .resource-list__carousel, media-gallery) slideshow-arrows .slideshow-control:hover .svg-wrapper,
    .vellano-gallery-nav__btn:hover > span {
      border-color: #141414;
    }
  }

  :is(.card-gallery, .resource-list__carousel, media-gallery) slideshow-arrows .slideshow-control:focus-visible .svg-wrapper,
  .vellano-gallery-nav__btn:focus-visible > span {
    outline: 2px solid #141414;
    outline-offset: 2px;
  }

  /* Zdjęcia na kartach: mniejsze kółka, bliżej krawędzi. */
  .card-gallery slideshow-arrows .slideshow-control.slideshow-control {
    padding-inline: 2px;
  }

  .card-gallery slideshow-arrows .slideshow-control .svg-wrapper {
    width: 32px;
    height: 32px;
  }

  @media (hover: none), screen and (max-width: 749px) {
    product-card .card-gallery slideshow-component:not([disabled='true']) slideshow-arrows .slideshow-control.slideshow-control {
      display: inline-flex;
      opacity: 1;
      animation: none;
      transform: none;
    }
  }

  /* Karuzele kart (np. „Wybierz swój klub” na telefonie): strzałki pod kartami, na środku. */
  slideshow-component.resource-list__carousel > slideshow-container {
    display: flex;
    flex-direction: column;
  }

  slideshow-component.resource-list__carousel > slideshow-container > slideshow-arrows {
    position: static;
    order: 2;
    inset: auto;
    justify-content: center;
    align-items: center;
    gap: 12px;
    padding-block-start: 20px;
  }

  slideshow-component.resource-list__carousel > slideshow-container > slideshow-arrows .slideshow-control.slideshow-control {
    opacity: 1;
    animation: none;
    transform: none;
    margin-inline-start: 0;
  }

  slideshow-component.resource-list__carousel > slideshow-container > slideshow-arrows .slideshow-control[disabled] {
    display: inline-flex;
    opacity: 0.35;
    pointer-events: none;
  }

  /* Na telefonie karta zajmuje większość ekranu, a kolejna lekko wystaje. */
  @container resource-list-carousel (max-width: 749px) {
    .resource-list__carousel .resource-list__slide:has(product-card) {
      --slide-width: min(76cqw, 340px);
    }
  }

  /* Galeria karty produktu na telefonie: strzałki dodaje skrypt poniżej. */
  .vellano-gallery-nav {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 4px;
    pointer-events: none;
    z-index: var(--layer-heightened, 2);
  }

  .vellano-gallery-nav__btn {
    pointer-events: auto;
  }

  .vellano-gallery-nav__btn--prev svg {
    transform: scaleX(-1);
  }

  @media screen and (min-width: 750px) {
    .vellano-gallery-nav {
      display: none;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    /* Strzałki w galerii karty produktu na telefonie. Horizon w układzie siatki pokazuje na telefonie
       przewijaną galerię bez strzałek; dokładamy dwa przyciski, które przesuwają ją o jedno zdjęcie. */
    var ARROW =
      '<svg viewBox="0 0 14 14" aria-hidden="true" focusable="false"><path d="M1 7h11M8 3l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>';

    function step(scroller, direction) {
      var width = scroller.clientWidth;
      var max = scroller.scrollWidth - width;
      var target = scroller.scrollLeft + direction * width;
      if (target > max + 4) target = 0;
      else if (target < -4) target = max;
      scroller.scrollTo({ left: target, behavior: 'smooth' });
    }

    function enhance(root) {
      var galleries = (root || document).querySelectorAll('media-gallery.media-gallery--grid slideshow-component');
      galleries.forEach(function (slideshow) {
        var container = slideshow.querySelector(':scope > slideshow-container');
        var scroller = container && container.querySelector(':scope > slideshow-slides');
        if (!scroller || scroller.children.length < 2) return;
        if (container.querySelector(':scope > .vellano-gallery-nav, :scope > slideshow-arrows')) return;

        var nav = document.createElement('div');
        nav.className = 'vellano-gallery-nav';
        nav.innerHTML =
          '<button type="button" class="vellano-gallery-nav__btn vellano-gallery-nav__btn--prev" aria-label="Poprzednie zdjęcie"><span>' +
          ARROW +
          '</span></button><button type="button" class="vellano-gallery-nav__btn vellano-gallery-nav__btn--next" aria-label="Następne zdjęcie"><span>' +
          ARROW +
          '</span></button>';
        container.appendChild(nav);

        nav.addEventListener('click', function (event) {
          var button = event.target.closest('.vellano-gallery-nav__btn');
          if (!button) return;
          event.preventDefault();
          event.stopPropagation();
          step(scroller, button.classList.contains('vellano-gallery-nav__btn--prev') ? -1 : 1);
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        enhance();
      });
    } else {
      enhance();
    }

    document.addEventListener('shopify:section:load', function (event) {
      enhance(event.target);
    });
  })();
</script>

{% schema %}
{
  "name": "Vellano – style globalne",
  "tag": "div",
  "class": "vellano-global-styles",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Ta sekcja nie wyświetla treści. Uzupełnia wygląd przycisków, nagłówków na telefonie, paska ogłoszeń i stopki na całej stronie."
    },
    {
      "type": "header",
      "content": "Przyciski"
    },
    {
      "type": "range",
      "id": "button_letter_spacing",
      "label": "Rozstrzelenie liter (setne części em)",
      "info": "8 oznacza 0,08 em. Wersaliki i zaokrąglenie ustawisz w Ustawieniach motywu → Przyciski.",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "button_font_size",
      "label": "Rozmiar tekstu w przyciskach",
      "options": [
        { "value": "", "label": "Jak tekst akapitu" },
        { "value": "0.8125rem", "label": "13 px" },
        { "value": "0.875rem", "label": "14 px" },
        { "value": "0.9375rem", "label": "15 px" }
      ],
      "default": "0.875rem"
    },
    {
      "type": "header",
      "content": "Nagłówki na telefonie"
    },
    {
      "type": "checkbox",
      "id": "mobile_heading_sizes",
      "label": "Mniejsze nagłówki poniżej 750 px",
      "info": "Na większych ekranach obowiązują rozmiary z Ustawień motywu → Typografia.",
      "default": true
    },
    {
      "type": "range",
      "id": "mobile_h1_size",
      "label": "Nagłówek 1",
      "min": 24,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 32,
      "visible_if": "{{ section.settings.mobile_heading_sizes }}"
    },
    {
      "type": "range",
      "id": "mobile_h2_size",
      "label": "Nagłówek 2",
      "min": 20,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 26,
      "visible_if": "{{ section.settings.mobile_heading_sizes }}"
    },
    {
      "type": "range",
      "id": "mobile_h3_size",
      "label": "Nagłówek 3",
      "min": 16,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 20,
      "visible_if": "{{ section.settings.mobile_heading_sizes }}"
    }
  ],
  "presets": [
    {
      "name": "Vellano – style globalne"
    }
  ]
}
{% endschema %}
