{% comment %}
  Section contract.
  Vellano – „Zestaw dla dwóch kibiców” na karcie produktu.
  Informuje o rabacie automatycznym (2 zawieszki za 259 zł zamiast 298 zł) i daje dwie drogi:
  1) formularz produktu (tag Liquid form 'product') dodający bieżący produkt w ilości 2 – opakowany w Horizonowy
     <product-form-component>, więc z JS dodaje do koszyka bez przeładowania i otwiera szufladę koszyka,
     a bez JS zwykły POST na /cart/add;
  2) link „Wybierz drugi herb” (ustawienie `link`, domyślnie kolekcja wszystkie-zawieszki).
  Spokojne tło #F7F5F1, bez czerwieni i bez przekreślonych cen. Kwoty są w edytowalnym tekście.
  Sekcja jest dostępna tylko w szablonach produktu (enabled_on), bo przycisk dodaje oglądany produkt.
  @example
  <!-- templates/product.json → "vellano_bundle": { "type": "vellano-bundle", "settings": { "link": "shopify://collections/wszystkie-zawieszki" } } -->
{% endcomment %}

{%- liquid
  assign product_resource = closest.product
  if product_resource == blank
    assign product_resource = product
  endif
  assign variant = product_resource.selected_or_first_available_variant
  assign bundle_quantity = 2

  assign second_link = section.settings.link
  if second_link == blank
    assign second_link = collections['wszystkie-zawieszki'].url | default: routes.all_products_collection_url
  endif

  assign heading = section.settings.heading | strip
  assign add_label = section.settings.add_label | strip
  assign link_label = section.settings.link_label | strip
  assign form_id = 'VellanoBundleForm-' | append: section.id
-%}

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-custom-{{ section.id }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="vellano-bundle">
    <div class="vellano-bundle__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="vellano-bundle__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if heading != blank -%}
        <h2 class="vellano-bundle__heading h2">{{ heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="vellano-bundle__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="vellano-bundle__actions">
      {%- if section.settings.show_add_button and product_resource != blank and variant != blank and add_label != blank -%}
        <product-form-component
          class="vellano-bundle__form"
          data-section-id="{{ section.id }}"
          data-product-id="{{ product_resource.id }}"
          data-product-url="{{ product_resource.url }}"
          data-quantity-default="{{ bundle_quantity }}"
          data-quantity-error-max="{{ 'products.product.quantity_error_max' | t }}"
          on:submit="/handleSubmit"
        >
          <div
            class="visually-hidden"
            aria-live="assertive"
            role="status"
            aria-atomic="true"
            ref="liveRegion"
          ></div>
          {%- form 'product', product_resource, id: form_id, class: 'vellano-bundle__form-element', data-type: 'add-to-cart-form' -%}
            <input
              type="hidden"
              name="id"
              ref="variantId"
              value="{{ variant.id }}"
            >
            <input
              type="hidden"
              name="quantity"
              value="{{ bundle_quantity }}"
            >
            <span
              class="product-form-text__error vellano-bundle__error hidden"
              ref="addToCartTextError"
            >
              <span class="svg-wrapper">
                {{- 'icon-error.svg' | inline_asset_content -}}
              </span>
            </span>
            <button
              type="submit"
              name="add"
              class="button vellano-bundle__button"
              {% unless variant.available %}
                disabled
              {% endunless %}
            >
              {%- if variant.available -%}
                {{ add_label | escape }}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </button>
          {%- endform -%}
        </product-form-component>
      {%- endif -%}

      {%- if section.settings.show_link and second_link != blank and link_label != blank -%}
        <a
          class="button-secondary vellano-bundle__button"
          href="{{ second_link }}"
        >
          {{- link_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .vellano-bundle {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 24px;
    min-width: 0;
  }

  .vellano-bundle__content {
    min-width: 0;
  }

  .vellano-bundle__eyebrow {
    margin: 0 0 8px;
    font-family: var(--font-accent--family);
    font-style: var(--font-accent--style);
    font-weight: var(--font-accent--weight);
    font-size: 0.75rem;
    line-height: 1.4;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  /* Krój, rozmiar i interlinia z ustawień H2 motywu (klasa .h2), jak w pozostałych sekcjach Vellano. */
  .vellano-bundle__heading {
    margin: 0;
    color: var(--color-foreground);
    text-wrap: balance;
  }

  .vellano-bundle__text {
    max-width: 34em;
    margin-block-start: 12px;
    font-size: 1rem;
    line-height: 1.6;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .vellano-bundle__text p {
    margin: 0;
  }

  .vellano-bundle__text p + p {
    margin-block-start: 0.5em;
  }

  .vellano-bundle__text strong {
    color: var(--color-foreground);
    font-weight: 500;
  }

  .vellano-bundle__actions {
    display: grid;
    gap: 12px;
    min-width: 0;
  }

  .vellano-bundle__form,
  .vellano-bundle__form-element {
    display: block;
    min-width: 0;
  }

  .vellano-bundle__button {
    width: 100%;
    min-height: 52px;
    padding-inline: 20px;
    font-weight: 500;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
  }

  .vellano-bundle__error:not(.hidden) {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-block-end: 8px;
    font-size: 0.875rem;
  }

  @media screen and (min-width: 990px) {
    .vellano-bundle {
      grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
      column-gap: 64px;
      align-items: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vellano – zestaw dla 2",
  "tag": "section",
  "class": "section-wrapper vellano-bundle-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Rabat nalicza w koszyku rabat automatyczny Shopify (2 zawieszki za 259 zł). Ta sekcja tylko o nim informuje – kwoty zmieniasz w tekście poniżej."
    },
    {
      "type": "header",
      "content": "Treść"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Nadtytuł",
      "info": "Opcjonalny, wersalikami nad nagłówkiem."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Nagłówek",
      "default": "Zestaw dla dwóch kibiców"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Tekst",
      "default": "<p>2 zawieszki za 259 zł zamiast 298 zł – oszczędzasz 39 zł. Rabat nalicza się automatycznie w koszyku.</p><p>Herby wybierasz dowolnie: dwa takie same albo dwa różne.</p>"
    },
    {
      "type": "header",
      "content": "Przyciski"
    },
    {
      "type": "checkbox",
      "id": "show_add_button",
      "label": "Przycisk „dodaj 2 sztuki”",
      "default": true
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Tekst przycisku",
      "info": "Przycisk dodaje do koszyka 2 sztuki oglądanego produktu.",
      "default": "Dodaj 2 sztuki tego herbu",
      "visible_if": "{{ section.settings.show_add_button }}"
    },
    {
      "type": "checkbox",
      "id": "show_link",
      "label": "Link do drugiego herbu",
      "default": true
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Tekst linku",
      "default": "Wybierz drugi herb",
      "visible_if": "{{ section.settings.show_link }}"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Puste pole = kolekcja „Wszystkie zawieszki”.",
      "visible_if": "{{ section.settings.show_link }}"
    },
    {
      "type": "header",
      "content": "Układ"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Szerokość",
      "options": [
        {
          "value": "page-width",
          "label": "Szerokość strony"
        },
        {
          "value": "full-width",
          "label": "Pełna szerokość"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Tło sekcji",
      "default": "#F7F5F1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Odstęp u góry",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Odstęp u dołu",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Vellano – zestaw dla 2"
    }
  ]
}
{% endschema %}
