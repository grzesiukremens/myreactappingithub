{%- doc -%}
  Vellano – liniowe ikony (obrys 1,25 px, currentColor), wspólne dla sekcji i bloków vellano-*.
  Ikony są dekoracyjne: zawsze aria-hidden="true" i focusable="false".

  @param {string} icon - Nazwa ikony: check, truck, clock, gift, box, return, shield, link, question, star.
  @param {string} [class] - Dodatkowa klasa CSS na <svg>.
  @param {number} [size] - Rozmiar w px (domyślnie 20).

  @example
  {% render 'vellano-icon', icon: 'truck', class: 'vellano-trust__icon', size: 18 %}
{%- enddoc -%}
{%- liquid
  assign icon_size = size | default: 20
  assign icon_fill = 'none'
  if icon == 'star'
    assign icon_fill = 'currentColor'
  endif
-%}
<svg
  class="vellano-icon vellano-icon--{{ icon }} {{ class }}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="{{ icon_fill }}"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}
    {%- when 'check' -%}
      <path d="M5 12.5l4.2 4.2L19 7"/>
    {%- when 'truck' -%}
      <path d="M2.75 5.75h11.5v9.5H2.75zM14.25 9h3.6l3.4 3.5v2.75h-7"/><circle cx="7" cy="17.5" r="1.9"/><circle cx="17.25" cy="17.5" r="1.9"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
    {%- when 'gift' -%}
      <path d="M4.5 10.5h15v9.75h-15zM3.25 7.25h17.5v3.25H3.25zM12 7.25v13"/><path d="M12 7.25c-1.4-2.9-4.9-3.5-4.9-1.3 0 1.3 2.4 1.3 4.9 1.3zM12 7.25c1.4-2.9 4.9-3.5 4.9-1.3 0 1.3-2.4 1.3-4.9 1.3z"/>
    {%- when 'box' -%}
      <path d="M3.5 7.5L12 3.5l8.5 4v9L12 20.5l-8.5-4z"/><path d="M3.5 7.5L12 11.5l8.5-4M12 11.5v9"/>
    {%- when 'return' -%}
      <path d="M8.5 6.5l-4 4 4 4"/><path d="M4.5 10.5H14a5 5 0 010 10h-2.5"/>
    {%- when 'shield' -%}
      <path d="M12 3.5L5 6v5.5c0 4.2 3 7.5 7 9 4-1.5 7-4.8 7-9V6z"/><path d="M8.8 12.2l2.2 2.2 4.2-4.4"/>
    {%- when 'link' -%}
      <path d="M10 14a3.5 3.5 0 005 0l3-3a3.54 3.54 0 00-5-5l-1 1"/><path d="M14 10a3.5 3.5 0 00-5 0l-3 3a3.54 3.54 0 005 5l1-1"/>
    {%- when 'question' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="M9.6 9.5a2.5 2.5 0 113.6 2.3c-.8.4-1.2 1-1.2 1.8v.4"/><path d="M12 16.8v.2"/>
    {%- when 'star' -%}
      <path d="M12 3.8l2.5 5.2 5.7.8-4.1 4 1 5.6L12 16.7l-5.1 2.7 1-5.6-4.1-4 5.7-.8z"/>
    {%- else -%}
      <path d="M5 12.5l4.2 4.2L19 7"/>
  {%- endcase -%}
</svg>
